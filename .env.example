# Server
PORT=8000
NODE_ENV=development
BACKEND_URL=http://localhost:8000

# Database (MongoDB)
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_CLUSTER=your-cluster.mongodb.net
DB_CLUSTER_NAME=YourDatabaseName

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_TOKEN=replace-with-random-256-bit-hex
JWT_EXPIRES_TIME=6h
JWT_REFRESH_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7

# Admin seed credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-strong-password

# Stripe
STRIPE_API_KEY=sk_test_your-stripe-secret-key
PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Razorpay
RAZOR_API_KEY=your-razorpay-api-key
RAZOR_SECRET=your-razorpay-secret

# Email (Brevo)
BREVO_API_KEY=your-brevo-api-key
SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME=Your Gallery Name

# SMTP (Mailtrap / production SMTP)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=your-smtp-from@yourdomain.com
MAIL_PASS=your-mail-password

# Cloudinary
CLOUDINARY_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Frontend links (for emails)
VERIFICATION_LINK=http://localhost:5173/verification
VERIFICATION_LINK_ADMIN=http://localhost:5173/admin-verification
RESET_LINK=http://localhost:5173/reset-password
RESET_LINK_ADMIN=http://localhost:5173/admin-reset-password